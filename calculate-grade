def calculate_grade(scores):
    # 1. เช็คก่อนว่าลิสต์ว่างหรือไม่ เพื่อป้องกัน ZeroDivisionError
    if not scores:
        return "No Data", 0  # หรือจะ return None, 0 ก็ได้

    # 2. ใช้ฟังก์ชัน sum() แทนการใช้ loop เพื่อหาผลรวม (มีประสิทธิภาพกว่า)
    total = sum(scores)
    
    # 3. คำนวณค่าเฉลี่ย
    average = total / len(scores)
    
    # 4. ตัดเกรด
    if average >= 80:
        grade = "A"
    elif average >= 70:
        grade = "B"
    elif average >= 60:
        grade = "C"
    elif average >= 50:
        grade = "D"
    else:
        grade = "F"
        
    return grade, average

# การทดสอบ
scores = [85, 92, 78, 88, 95]
grade, avg = calculate_grade(scores)
print(f"Average: {avg}, Grade: {grade}")

# ทดสอบกรณีลิสต์ว่าง (ป้องกัน Bug)
empty_scores = []
print(calculate_grade(empty_scores))
